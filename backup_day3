def safe_display_value(value):
    """
    Safely convert extracted values into something
    Streamlit can display without crashing.
    """

    if value is None:
        return "Not detected"

    if isinstance(value, dict):

        cleaned = {}

        for key, item in value.items():

            if item is None:
                cleaned[key] = "Not detected"
            else:
                cleaned[key] = item

        return cleaned

    if isinstance(value, list):

        if len(value) == 0:
            return "Not detected"

        return value

    if isinstance(value, str):

        if not value.strip():
            return "Not detected"

        return value

    return value


def display_rule_value(result):
    """
    Safely display the detected value from a compliance rule.

    Different rules may store values differently, so we never
    assume that result['value'] exists.
    """

    if not isinstance(result, dict):
        return "Not available"

    value = result.get("value")

    if value is not None:
        return safe_display_value(value)

    # Some rule results may use another field name.
    for key in [
        "detected_value",
        "field_value",
        "extracted_value"
    ]:

        if key in result:
            return safe_display_value(
                result.get(key)
            )

    return "Not detected"


