    import json
import os


# =========================================================
# CONFIGURATION
# =========================================================

RULES_FILE = os.path.join(
    "legal_data",
    "compliance_rules.json"
)


# =========================================================
# LOAD RULES
# =========================================================

def load_rules():
    """
    Load compliance rules.

    Supports both:
    1. A direct list of rules
    2. A dictionary containing a 'rules' list
    """

    with open(
        RULES_FILE,
        "r",
        encoding="utf-8"
    ) as file:

        data = json.load(file)

    if isinstance(data, list):
        return data

    if isinstance(data, dict):

        rules = data.get("rules")

        if isinstance(rules, list):
            return rules

    raise ValueError(
        "compliance_rules.json must contain a list "
        "of rule objects or a dictionary containing "
        "'rules'."
    )


# =========================================================
# GET NESTED FIELD VALUE
# =========================================================

def get_field_value(product, field):

    if not field:
        return None

    value = product

    for part in field.split("."):

        if not isinstance(value, dict):
            return None

        value = value.get(part)

    return value


# =========================================================
# CHECK WHETHER A VALUE ACTUALLY EXISTS
# =========================================================

def has_value(value):

    if value is None:
        return False

    if isinstance(value, str):
        return bool(value.strip())

    if isinstance(value, dict):

        return any(
            has_value(item)
            for item in value.values()
        )

    if isinstance(value, list):

        return len(value) > 0

    return True


# =========================================================
# CREATE DISPLAY VALUE
# =========================================================

def clean_display_value(value):

    if value is None:
        return "Not detected"

    if isinstance(value, dict):

        cleaned = {}

        for key, item in value.items():

            if item is None:
                cleaned[key] = "Not detected"
            else:
                cleaned[key] = item

        return cleaned

    return value


# =========================================================
# EVALUATE INDIVIDUAL RULE
# =========================================================

def evaluate_rule(rule, product):

    rule_id = rule.get("id")

    field = rule.get("field")

    check_type = str(
        rule.get(
            "check_type",
            ""
        )
    ).lower().strip()


    # =====================================================
    # MANUAL / HUMAN REVIEW RULES
    # =====================================================

    if rule_id == "LM_DECLARATION_LANGUAGE":

        return (
            "NEEDS_REVIEW",
            None,
            "Language compliance requires human/visual review."
        )


    if rule_id in {
        "FSSAI_FOOD_ADDITIVES",
        "FSSAI_INSTRUCTIONS",
        "FSSAI_ALLERGEN"
    }:

        value = (
            get_field_value(
                product,
                field
            )
            if field
            else None
        )

        return (
            "NEEDS_REVIEW",
            value,
            "This requirement depends on the product and "
            "requires contextual or human review."
        )


    # =====================================================
    # IMPORTED FOOD RULES
    # =====================================================

    if rule_id == "FSSAI_COUNTRY_ORIGIN":

        importer = get_field_value(
            product,
            "importer"
        )

        if has_value(importer):

            value = get_field_value(
                product,
                field
            )

            if has_value(value):

                return (
                    "COMPLIANT",
                    value,
                    "Imported-product context detected and "
                    "country-of-origin information was detected."
                )

            return (
                "NEEDS_REVIEW",
                value,
                "Importer information is present, but "
                "country-of-origin information was not detected."
            )

        return (
            "NOT_APPLICABLE",
            None,
            "No importer information was detected, so the "
            "imported-food requirement is not triggered "
            "by the current OCR result."
        )


    if rule_id == "FSSAI_IMPORTER":

        importer = get_field_value(
            product,
            "importer"
        )

        if has_value(importer):

            return (
                "COMPLIANT",
                importer,
                "Importer information was detected."
            )

        return (
            "NOT_APPLICABLE",
            None,
            "No importer information was detected. "
            "The product is currently treated as domestic."
        )


    # =====================================================
    # INVALID RULE
    # =====================================================

    if not field:

        return (
            "NEEDS_REVIEW",
            None,
            "The compliance rule does not specify a field "
            "that can be checked automatically."
        )


    # =====================================================
    # GET VALUE
    # =====================================================

    value = get_field_value(
        product,
        field
    )

    detected = has_value(
        value
    )


    # =====================================================
    # MISSING VALUE
    # =====================================================

    if not detected:

        return (
            "NEEDS_REVIEW",
            value,
            "The required information was not detected in "
            "the uploaded image. This is not treated as proof "
            "of a legal violation because OCR may have missed it."
        )


    # =====================================================
    # QUANTITY CHECK
    # =====================================================

    quantity_rule = (
        rule_id in {
            "LM_NET_QUANTITY",
            "LM_QUANTITY_UNIT"
        }
        or check_type == "quantity"
    )


    if quantity_rule:

        if isinstance(value, dict):

            number = value.get(
                "value"
            )

            unit = value.get(
                "unit"
            )

            if has_value(number) and has_value(unit):

                return (
                    "COMPLIANT",
                    value,
                    "Net quantity value and unit were detected."
                )

        return (
            "NEEDS_REVIEW",
            value,
            "Net quantity information was detected only "
            "partially or could not be reliably verified."
        )


    # =====================================================
    # MRP CHECK
    # =====================================================

    mrp_rule = (
        rule_id == "LM_MRP"
        or check_type == "mrp"
    )


    if mrp_rule:

        if isinstance(value, dict):

            number = value.get(
                "value"
            )

            if has_value(number):

                return (
                    "COMPLIANT",
                    value,
                    "MRP information was detected."
                )

        return (
            "NEEDS_REVIEW",
            value,
            "MRP was not reliably detected in the uploaded image."
        )


    # =====================================================
    # DATE MARKING CHECK
    # =====================================================

    date_rule = (
        rule_id == "FSSAI_DATE_MARKING"
        or check_type == "date"
    )


    if date_rule:

        if isinstance(value, dict):

            date_fields = [
                "manufacturing_date",
                "packaging_date",
                "expiry_date",
                "use_by_date"
            ]

            detected_dates = []

            for date_field in date_fields:

                date_value = value.get(
                    date_field
                )

                if has_value(
                    date_value
                ):

                    detected_dates.append(
                        date_field
                    )

            if detected_dates:

                return (
                    "COMPLIANT",
                    value,
                    "Date-marking information was detected. "
                    "Detailed format and applicability may still "
                    "require verification."
                )

        return (
            "NEEDS_REVIEW",
            value,
            "Applicable date-marking information was not "
            "reliably detected."
        )


    # =====================================================
    # MANUFACTURER CHECK
    # =====================================================

    manufacturer_rule = (
        rule_id == "LM_MANUFACTURER_PACKER"
        or check_type == "manufacturer"
    )


    if manufacturer_rule:

        if isinstance(value, dict):

            name = value.get(
                "name"
            )

            address = value.get(
                "address"
            )

            if has_value(name):

                if has_value(address):

                    return (
                        "COMPLIANT",
                        value,
                        "Manufacturer name and address were detected."
                    )

                return (
                    "NEEDS_REVIEW",
                    value,
                    "Manufacturer name was detected, but the "
                    "complete address could not be reliably verified."
                )

        return (
            "NEEDS_REVIEW",
            value,
            "Manufacturer/packer information was not reliably detected."
        )


    # =====================================================
    # CONSUMER CONTACT
    # =====================================================

    if rule_id == "LM_CONSUMER_CONTACT":

        if isinstance(value, dict):

            phone = value.get(
                "telephone"
            )

            email = value.get(
                "email"
            )

            address = value.get(
                "address"
            )

            if (
                has_value(phone)
                or has_value(email)
                or has_value(address)
            ):

                return (
                    "COMPLIANT",
                    value,
                    "Consumer contact information was detected. "
                    "Detailed completeness should be verified."
                )

        return (
            "NEEDS_REVIEW",
            value,
            "Consumer contact information was not reliably detected."
        )


    # =====================================================
    # FSSAI LICENSE
    # =====================================================

    if rule_id == "FSSAI_LICENSE":

        license_number = get_field_value(
            product,
            "fssai_license_number"
        )

        if has_value(
            license_number
        ):

            license_text = str(
                license_number
            )

            digits_only = "".join(
                character
                for character in license_text
                if character.isdigit()
            )

            if len(digits_only) == 14:

                return (
                    "COMPLIANT",
                    license_number,
                    "A 14-digit FSSAI licence number was detected."
                )

            return (
                "NEEDS_REVIEW",
                license_number,
                "An FSSAI licence value was detected, but its "
                "format could not be reliably verified."
            )

        return (
            "NEEDS_REVIEW",
            license_number,
            "FSSAI licence information was not detected."
        )


    # =====================================================
    # BATCH / LOT
    # =====================================================

    if rule_id == "FSSAI_BATCH":

        batch = get_field_value(
            product,
            "batch_lot_code"
        )

        if has_value(batch):

            batch_text = str(
                batch
            ).strip()

            # Reject obvious OCR garbage.
            if batch_text.lower() in {
                "mfo",
                "mfd",
                "mf0",
                "none",
                "null"
            }:

                return (
                    "NEEDS_REVIEW",
                    batch,
                    "The OCR result resembles a manufacturing/date "
                    "label rather than a reliable batch or lot code."
                )

            return (
                "COMPLIANT",
                batch,
                "A batch/lot value was detected. Its physical "
                "legibility should still be verified."
            )

        return (
            "NEEDS_REVIEW",
            batch,
            "Batch/lot information was not reliably detected."
        )


    # =====================================================
    # FOOD NAME
    # =====================================================

    if rule_id == "FSSAI_FOOD_NAME":

        if has_value(
            value
        ):

            return (
                "COMPLIANT",
                value,
                "Food name was detected."
            )

        return (
            "NEEDS_REVIEW",
            value,
            "Food name was not detected."
        )


    # =====================================================
    # COMMON / GENERIC NAME
    # =====================================================

    if rule_id == "LM_COMMON_NAME":

        if has_value(
            value
        ):

            return (
                "COMPLIANT",
                value,
                "Common/generic name was detected."
            )

        return (
            "NEEDS_REVIEW",
            value,
            "Common/generic name was not detected."
        )


    # =====================================================
    # DEFAULT PRESENCE CHECK
    # =====================================================

    if detected:

        return (
            "COMPLIANT",
            value,
            "Required information was detected. "
            "Detailed legal format/applicability may require "
            "additional verification."
        )


    return (
        "NEEDS_REVIEW",
        value,
        "Information was not reliably detected."
    )


# =========================================================
# RUN COMPLETE COMPLIANCE CHECK
# =========================================================

def run_compliance_check(package_data):

    rules = load_rules()

    product = package_data.get(
        "product_label",
        {}
    )

    rule_results = []

    compliant = 0
    potential_violations = 0
    needs_review = 0
    not_applicable = 0


    # =====================================================
    # PROCESS EACH RULE
    # =====================================================

    for rule in rules:

        if not isinstance(
            rule,
            dict
        ):
            continue


        status, value, reason = evaluate_rule(
            rule,
            product
        )


        # -------------------------------------------------
        # COUNT STATUS
        # -------------------------------------------------

        if status == "COMPLIANT":

            compliant += 1

        elif status == "POTENTIAL_VIOLATION":

            potential_violations += 1

        elif status == "NEEDS_REVIEW":

            needs_review += 1

        elif status == "NOT_APPLICABLE":

            not_applicable += 1


        # -------------------------------------------------
        # SAVE RESULT
        # -------------------------------------------------

        rule_results.append({

            "rule_id": rule.get(
                "id"
            ),

            "category": rule.get(
                "category"
            ),

            "requirement": rule.get(
                "requirement"
            ),

            "source": rule.get(
                "source"
            ),

            "legal_reference": rule.get(
                "legal_reference"
            ),

            "status": status,

            "field": rule.get(
                "field"
            ),

            "value": clean_display_value(
                value
            ),

            "automation_level": rule.get(
                "automation_level",
                "AUTOMATED"
            ),

            "reason": reason
        })


    # =====================================================
    # OVERALL STATUS
    # =====================================================

    if potential_violations > 0:

        overall_status = (
            "POTENTIAL VIOLATION"
        )

    elif needs_review > 0:

        overall_status = (
            "NEEDS REVIEW"
        )

    elif not_applicable == len(rule_results):

        overall_status = (
            "NOT APPLICABLE"
        )

    else:

        overall_status = (
            "COMPLIANT"
        )


    # =====================================================
    # RETURN RESULT
    # =====================================================

    return {

        "overall_status": overall_status,

        "summary": {

            "total_rules": len(
                rule_results
            ),

            "compliant": compliant,

            "potential_violations": (
                potential_violations
            ),

            "needs_review": needs_review,

            "not_applicable": not_applicable
        },

        "rule_results": rule_results
    }

